{
  "name": "cloudpost",
  "description": "CloudPost Desktop - API Development and Testing Platform",
  "author": "CloudPost Team",
  "private": true,
  "version": "2.4.0",
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "dev": "tsx server.ts",
    "desktop:dev": "concurrently \"npm run dev\" \"wait-on http://localhost:3000 && cross-env ELECTRON_ENV=development electron .\"",
    "build:react": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "prebuild:desktop": "node scripts/prepare-icons.cjs",
    "build:desktop": "node scripts/prepare-icons.cjs && npm run build:react && electron-builder && node scripts/stamp-exe-icon.cjs",
    "build:all": "node scripts/prepare-icons.cjs && npm run build:react && electron-builder -w -l --mac zip && node scripts/stamp-exe-icon.cjs",
    "build:win": "node scripts/prepare-icons.cjs && npm run build:react && electron-builder --win && node scripts/stamp-exe-icon.cjs",
    "build:mac": "node scripts/prepare-icons.cjs && npm run build:react && electron-builder --mac",
    "build:mac:arm": "node scripts/prepare-icons.cjs && npm run build:react && electron-builder --mac --arm64",
    "build:mac:intel": "node scripts/prepare-icons.cjs && npm run build:react && electron-builder --mac --x64",
    "build:mac:universal": "node scripts/prepare-icons.cjs && npm run build:react && electron-builder --mac --universal",
    "build:mac:zip": "node scripts/prepare-icons.cjs && npm run build:react && electron-builder --mac zip",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit"
  },
  "build": {
    "appId": "com.cloudpost.desktop",
    "productName": "CloudPost",
    "directories": {
      "output": "dist_desktop"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "public/**/*",
      "build/**/*",
      "package.json"
    ],
    "icon": "build/icon.png",
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "CloudPost"
    },
    "mac": {
      "icon": "build/icon.icns",
      "category": "public.app-category.developer-tools",
      "target": [
        {
          "target": "dmg",
          "arch": ["arm64", "x64"]
        },
        {
          "target": "zip",
          "arch": ["arm64", "x64"]
        }
      ],
      "darkModeSupport": true,
      "identity": null
    },
    "dmg": {
      "title": "CloudPost ${version}",
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ],
      "window": {
        "width": 540,
        "height": 380
      }
    },
    "linux": {
      "icon": "build/icons",
      "category": "Development",
      "target": [
        "AppImage",
        "deb",
        "tar.gz"
      ]
    }
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "cors": "^2.8.5",
    "d3": "^7.9.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jszip": "^3.10.1",
    "lucide-react": "^0.475.0",
    "motion": "^12.4.7",
    "mysql2": "^3.12.0",
    "playwright": "^1.63.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.9",
    "@types/cors": "^2.8.17",
    "@types/d3": "^7.4.3",
    "@types/express": "^4.17.21",
    "@types/jszip": "^3.4.1",
    "@types/node": "^22.13.5",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "@vue/compiler-dom": "^3.5.42",
    "autoprefixer": "^10.4.20",
    "concurrently": "^8.2.2",
    "cross-env": "^10.1.0",
    "electron": "^30.5.1",
    "electron-builder": "^24.13.3",
    "esbuild": "^0.25.0",
    "png2icons": "^2.0.1",
    "rcedit": "^5.0.2",
    "tailwindcss": "^4.0.9",
    "tsx": "^4.19.3",
    "typescript": "~5.7.2",
    "vite": "^6.2.0",
    "wait-on": "^9.1.0"
  }
}
